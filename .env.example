# RAG System Configuration
# Copy this file to .env and update values as needed

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================

# Storage directory for persistent FAISS index and chunks (default: storage/)
STORAGE_DIR=storage

# ============================================================================
# TEXT CHUNKING CONFIGURATION
# ============================================================================

# Maximum words per chunk (default: 50)
CHUNK_MAX_WORDS=50

# Number of words to overlap between chunks (default: 5)
# Helps preserve context at chunk boundaries
CHUNK_OVERLAP_WORDS=5

# Enable sentence-aware chunking to preserve sentence boundaries (default: false)
# Set to "true" to keep sentences intact instead of splitting on word count
CHUNK_SENTENCE_AWARE=false

# Number of sentences to overlap when sentence_aware=true (default: auto-calculated)
# If not set, calculated as CHUNK_OVERLAP_WORDS // 5
# CHUNK_OVERLAP_SENTENCES=1

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Frontend URL for CORS configuration
# FRONTEND_URL=http://localhost:3000

# ============================================================================
# NOTES
# ============================================================================
# - STORAGE_DIR: All chunks and FAISS indexes persist to this directory
# - CHUNK_SENTENCE_AWARE: When enabled, sentences are kept intact across chunks
# - Overlapping chunks help RAG retrieval maintain context between segment boundaries
